# --- Script writer ---
# gemini (default, uses GEMINI_API_KEY) | claude
SCRIPT_PROVIDER=gemini
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Look up this week's trends with Gemini + Google Search before writing (on | off)
TRENDS=on
# Language of the jokes. Examples: English | Hinglish (Roman Urdu/Hindi mixed with English)
CONTENT_LANGUAGE=English
# AUDIENCE=teens and young adults worldwide, especially the US, UK, India and Pakistan

# --- Voice ---
# gemini (default) | elevenlabs | espeak (offline robot voice, testing only)
TTS_PROVIDER=gemini
GEMINI_API_KEY=
# en-US, en-IN, hi-IN, ur-PK …
TTS_LANGUAGE=en-US
# One voice per character. Try: Puck, Fenrir, Charon, Kore, Leda, Orus, Zephyr
SKETCH_VOICE=Puck
BRO_VOICE=Fenrir
# SKETCH_STYLE=Sketch is a nerdy, slightly dramatic young guy; warm, expressive and natural
# BRO_STYLE=Bro is a laid-back, overconfident best friend; easygoing, deadpan, a little smug
# Speaking pace in words per second. Every voice is measured and slowed to this.
# 2.2 = slow, 2.5 = relaxed (default), 3.0 = normal chat
TARGET_WPS=2.5
# Extra manual slow-down on top (1.0 = none)
VOICE_SPEED=1.0
# Pause between lines in seconds
BEAT_GAP=0.6
# Pitch (1.0 = natural; changed with formants preserved, keep within 0.9–1.1)
# SKETCH_PITCH=1.0
# BRO_PITCH=1.0

# ElevenLabs (only if TTS_PROVIDER=elevenlabs)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_BRO_VOICE_ID=

# --- YouTube (OAuth client type "Desktop app") ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
UPLOAD_MODE=schedule
# 19:00 Pakistan time = 10 AM New York / 3 PM London
PUBLISH_TIME=19:00
PUBLISH_UTC_OFFSET=5
PUBLISH_DELAY_DAYS=0
VIDEO_LANGUAGE=en

# --- Facebook Page Reels (optional; skipped when these are empty) ---
# For `npm run auth:facebook` only:
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# Printed by `npm run auth:facebook`:
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
# FACEBOOK_ENABLED=true
# Daily Page posts: Reel at PUBLISH_TIME, meme photo FACEBOOK_PHOTO_DELAY_HOURS later, Story when the run finishes
# FACEBOOK_REEL=true
# FACEBOOK_PHOTO=true
# FACEBOOK_STORY=true
# FACEBOOK_PHOTO_DELAY_HOURS=3

# --- Instagram (Business account linked to the Page; printed by `npm run auth:facebook`) ---
# Uses FACEBOOK_PAGE_TOKEN, which needs instagram_basic + instagram_content_publish.
# Optional: found from the Page automatically
# INSTAGRAM_ACCOUNT_ID=
# INSTAGRAM_REEL=true
# INSTAGRAM_PHOTO=true
# INSTAGRAM_STORY=true
# FACEBOOK_GRAPH_VERSION=v26.0
WATERMARK=@sketchman

# --- Local tools (only if not on PATH) ---
# RHUBARB_PATH=/path/to/rhubarb
# CHROME_PATH=
